<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
RewriteEngine On
RewriteRule (^|/)\. - [F,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Archivos de configuración, backend alternativo y documentación interna.
<FilesMatch "^(config\.local\.php|config\.local\.php\.example|SECURITY-SETUP\.md|HOSTINGER-SETUP\.md|database\.sql|data\.json|server\.js|render\.yaml|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>
